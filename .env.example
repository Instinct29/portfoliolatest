# Gemini API key for MG Assistant (get one at https://aistudio.google.com/apikey)
GOOGLE_AI_API_KEY=

# Alternate names the chat route also accepts:
# GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY=

# Optional: override the chat model (default: gemini-3.5-flash-lite)
# CHAT_GEMINI_MODEL=gemini-3.5-flash-lite

NEXT_PUBLIC_SITE_URL=https://portfoliolatest.vercel.app

# Optional: global leaderboard (Postgres).
# 1. Set DATABASE_URL or POSTGRES_URL
# 2. Run docs/game-schema.sql once against that database
# Without these, the game still works; ranked submission is unavailable.
# DATABASE_URL=postgres://...
